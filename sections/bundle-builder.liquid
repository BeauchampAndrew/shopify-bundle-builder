{%- comment -%}
  Build-your-own bundle box. One portable section for any Online Store 2.0 theme.
  Shoppers pick a box size (each size has its own discount), fill the box with +/- buttons,
  see every slot, a live total and savings, then add the whole box to the cart in one click.
  The matching discount code (set per size) is applied to the cart after adding.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sizes = section.blocks | where: 'type', 'size'
  assign cats = section.blocks | where: 'type', 'category'
  assign bundle_presets = section.blocks | where: 'type', 'preset'

  assign default_size = 0
  for b in sizes
    if b.settings.default and default_size == 0
      assign default_size = b.settings.size
    endif
  endfor
  if default_size == 0 and sizes.size > 0
    assign default_size = sizes.first.settings.size
  endif

  assign anchor_prefix = 'bbx-' | append: section.id | append: '-'

  assign font_stack = ''
  if s.use_custom_font and s.font != blank
    assign font_stack = s.font.family | append: ', ' | append: s.font.fallback_families
    assign font_bold = s.font | font_modify: 'weight', '700'
    assign font_heavy = s.font | font_modify: 'weight', '800'
    assign font_black = s.font | font_modify: 'weight', '900'
  endif
-%}

{%- if font_stack != '' -%}
  <style>
    {{ s.font | font_face: font_display: 'swap' }}
    {%- if font_bold %}{{ font_bold | font_face: font_display: 'swap' }}{% endif -%}
    {%- if font_heavy %}{{ font_heavy | font_face: font_display: 'swap' }}{% endif -%}
    {%- if font_black %}{{ font_black | font_face: font_display: 'swap' }}{% endif -%}
  </style>
{%- endif -%}

<bundle-builder
  class="bbx{% if s.uppercase %} bbx--upper{% endif %}{% if s.sticky_nav %} bbx--sticky-nav{% endif %} bbx--fit-{{ s.image_fit }}"
  id="bbx-{{ section.id }}"
  style="
    --bbx-bg: {{ s.color_bg }};
    --bbx-ink: {{ s.color_ink }};
    --bbx-btn-fg: {{ s.color_button_text }};
    --bbx-card: {{ s.color_card }};
    --bbx-selected: {{ s.color_selected }};
    --bbx-panel-bg: {{ s.color_panel }};
    --bbx-max: {{ s.max_width }}px;
    --bbx-radius: {{ s.radius }}px;
    --bbx-btn-radius: {% case s.button_shape %}{% when 'rounded' %}12px{% when 'square' %}0px{% else %}999px{% endcase %};
    --bbx-border: {{ s.border_width }}px;
    --bbx-cols-d: {{ s.columns_desktop }};
    --bbx-cols-m: {{ s.columns_mobile }};
    --bbx-sticky: {{ s.sticky_top }}px;
    --bbx-pt: {{ s.padding_top }}px;
    --bbx-pb: {{ s.padding_bottom }}px;
    {%- if font_stack != '' %} --bbx-font: {{ font_stack | escape }};{% endif -%}
  "
  data-section-id="{{ section.id }}"
  data-money-sample="{{ 123456789 | money | strip_html | escape }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-update-url="{{ routes.cart_update_url }}"
  data-root-url="{{ routes.root_url }}"
  data-after-add="{{ s.after_add }}"
  data-auto-upgrade="{{ s.auto_upgrade }}"
  data-label-status-empty="{{ s.label_status_empty | escape }}"
  data-label-status-partial="{{ s.label_status_partial | escape }}"
  data-label-status-full="{{ s.label_status_full | escape }}"
  data-label-status-next="{{ s.label_status_next | escape }}"
  data-label-saving-partial="{{ s.label_saving_partial | escape }}"
  data-label-saving-full="{{ s.label_saving_full | escape }}"
  data-label-cta-more="{{ s.label_cta_more | escape }}"
  data-label-cta-full="{{ s.label_cta_full | escape }}"
  data-label-cta-adding="{{ s.label_cta_adding | escape }}"
  data-label-cta-added="{{ s.label_cta_added | escape }}"
  data-label-upgraded="{{ s.label_upgraded | escape }}"
  data-label-error="{{ s.label_error | escape }}"
  data-label-code-error="{{ s.label_code_error | escape }}"
  data-label-size="{{ s.label_size | escape }}"
  data-label-choose="{{ s.label_step_products | escape }}"
  data-label-preset-added="{{ s.label_preset_added | escape }}"
>
  <div class="bbx__inner">
    {%- if s.heading != blank or s.subheading != blank -%}
      <header class="bbx__header">
        {%- if s.heading != blank -%}<h2 class="bbx__heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="bbx__subheading">{{ s.subheading }}</p>{%- endif -%}
      </header>
    {%- endif -%}

    {%- if s.show_nav and cats.size > 1 -%}
      <nav class="bbx__nav" aria-label="{{ s.label_nav | escape }}">
        {%- for block in cats -%}
          {%- if block.settings.title != blank -%}
            <a class="bbx__pill" href="#{{ anchor_prefix }}{{ block.id }}" data-bbx-nav>{{ block.settings.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="bbx__layout">
      {%- comment -%} Builder panel. First in the DOM so it sits above the catalog on mobile. {%- endcomment -%}
      <aside class="bbx__panel" data-bbx-panel aria-label="{{ s.label_step_size | escape }}">
        <div class="bbx__step">
          <h3 class="bbx__step-title"><span class="bbx__step-num" aria-hidden="true">1</span>{{ s.label_step_size }}</h3>

          {%- if sizes.size > 0 -%}
            <div class="bbx__sizes" role="group" aria-label="{{ s.label_step_size | escape }}">
              {%- for b in sizes -%}
                <button
                  type="button"
                  class="bbx__size{% if b.settings.size == default_size %} is-active{% endif %}"
                  aria-pressed="{% if b.settings.size == default_size %}true{% else %}false{% endif %}"
                  data-bbx-size="{{ b.settings.size }}"
                  data-discount="{{ b.settings.discount }}"
                  data-code="{{ b.settings.code | strip | escape }}"
                  {{ b.shopify_attributes }}
                >
                  {%- if b.settings.badge != blank -%}
                    <span
                      class="bbx__badge"
                      style="--bbx-badge-bg: {{ b.settings.badge_bg | default: b.settings.badge_color }}; --bbx-badge-fg: {{ b.settings.badge_text }};"
                    >{{ b.settings.badge }}</span>
                  {%- endif -%}
                  <span class="bbx__size-name">{{ s.label_size | replace: '[size]', b.settings.size }}</span>
                  {%- if b.settings.discount > 0 -%}
                    <span class="bbx__size-save">{{ s.label_size_save | replace: '[percent]', b.settings.discount }}</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
            {%- if request.design_mode -%}
              {%- for b in sizes -%}
                {%- if b.settings.discount > 0 and b.settings.code == blank -%}
                  <p class="bbx__editor-hint">The {{ b.settings.size }}-item size shows {{ b.settings.discount }}% savings but has no discount code, so checkout won't apply it. Add the code in its Box size block.</p>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- elsif request.design_mode -%}
            <p class="bbx__editor-hint">Add a "Box size" block to set your box sizes and discounts.</p>
          {%- endif -%}
        </div>

        <hr class="bbx__rule">

        <div class="bbx__step">
          <h3 class="bbx__step-title"><span class="bbx__step-num" aria-hidden="true">2</span>{{ s.label_step_products }}</h3>

          <div class="bbx__progress" data-bbx-progress style="--bbx-fill: 0;" aria-hidden="true">
            <div class="bbx__track"><div class="bbx__fill"></div></div>
            <span class="bbx__knob bbx__knob--count" data-bbx-count>0</span>
            <span class="bbx__knob bbx__knob--end" data-bbx-target>{{ default_size }}</span>
          </div>

          <p class="bbx__status" data-bbx-status aria-live="polite">
            {%- liquid
              assign default_discount = 0
              for b in sizes
                if b.settings.size == default_size
                  assign default_discount = b.settings.discount
                endif
              endfor
              echo s.label_status_empty | replace: '[count]', default_size | replace: '[percent]', default_discount
            -%}
          </p>

          <ul class="bbx__slots" data-bbx-slots>
            {%- if default_size > 0 -%}
              {%- for i in (1..default_size) -%}
                <li class="bbx__slot"><button type="button" class="bbx__slot-empty" data-bbx-empty aria-label="{{ s.label_step_products | escape }}">+</button></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
          <button type="button" class="bbx__clear" data-bbx-clear hidden>{{ s.label_clear }}</button>
        </div>

        <hr class="bbx__rule">

        <div class="bbx__summary">
          <span class="bbx__total-label">{{ s.label_total }}</span>
          <span class="bbx__total-prices">
            <s data-bbx-compare hidden></s>
            <strong data-bbx-price>{{ 0 | money }}</strong>
          </span>
          <p class="bbx__saving" data-bbx-saving></p>
        </div>

        <button type="button" class="bbx__cta" data-bbx-cta aria-disabled="true">
          {{- s.label_cta_more | replace: '[count]', default_size -}}
        </button>
        <p class="bbx__error" data-bbx-error role="alert" hidden></p>

        {%- if s.footnote != blank -%}
          <p class="bbx__note">{{ s.footnote }}</p>
        {%- endif -%}
      </aside>

      <div class="bbx__catalog" data-bbx-catalog>
        {%- if bundle_presets.size > 0 -%}
          <div class="bbx__presets">
            {%- if s.presets_heading != blank -%}
              <p class="bbx__presets-title">{{ s.presets_heading }}</p>
            {%- endif -%}
            <div class="bbx__presets-list">
              {%- for block in bundle_presets -%}
                {%- capture preset_items -%}
                  [
                  {%- for product in block.settings.products -%}
                    {%- liquid
                      assign v = product.selected_or_first_available_variant
                      assign img = v.featured_image | default: product.featured_image
                    -%}
                    {%- liquid
                      assign item_title = product.title
                      unless product.has_only_default_variant
                        assign item_title = item_title | append: ' (' | append: v.title | append: ')'
                      endunless
                    -%}
                    {"id":"{{ v.id }}","price":{{ v.price }},"title":{{ item_title | json }},"image":{% if img %}{{ img | image_url: width: 300 | json }}{% else %}""{% endif %},"available":{{ v.available }}}
                    {%- unless forloop.last %},{% endunless -%}
                  {%- endfor -%}
                  ]
                {%- endcapture -%}
                <button
                  type="button"
                  class="bbx__preset"
                  data-bbx-preset
                  data-size="{{ block.settings.size }}"
                  data-name="{{ block.settings.title | escape }}"
                  data-items="{{ preset_items | strip | escape }}"
                  {{ block.shopify_attributes }}
                  {% if block.settings.products == blank %}aria-disabled="true"{% endif %}
                >
                  {{- block.settings.title -}}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
        {%- for block in cats -%}
          {%- liquid
            assign list = block.settings.products
            if list == blank and block.settings.collection != blank
              assign list = block.settings.collection.products
            endif
          -%}
          <section class="bbx__cat" id="{{ anchor_prefix }}{{ block.id }}" data-bbx-cat {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="bbx__cat-title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if list != blank -%}
              <ul class="bbx__grid">
                {%- for product in list limit: block.settings.limit -%}
                  {%- liquid
                    assign v = product.selected_or_first_available_variant
                    assign img = v.featured_image | default: product.featured_image
                  -%}
                  <li
                    class="bbx__card"
                    data-bbx-card
                    data-variant-id="{{ v.id }}"
                    data-price="{{ v.price }}"
                    data-title="{{ product.title | escape }}{% unless product.has_only_default_variant %} ({{ v.title | escape }}){% endunless %}"
                    data-image="{% if img %}{{ img | image_url: width: 300 }}{% endif %}"
                    data-available="{{ v.available }}"
                  >
                    <div class="bbx__card-media">
                      {%- if img -%}
                        {{
                          img
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            widths: '200, 300, 400, 600, 800',
                            sizes: '(min-width: 990px) 20vw, 45vw',
                            class: 'bbx__card-img',
                            alt: product.title
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'bbx__card-img bbx__placeholder' }}
                      {%- endif -%}
                    </div>
                    <p class="bbx__card-title">{{ product.title }}</p>
                    {%- unless product.has_only_default_variant -%}
                      <p class="bbx__card-variant">{{ v.title }}</p>
                    {%- endunless -%}
                    <p class="bbx__card-price">
                      {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s> {% endif -%}
                      {{ v.price | money }}
                    </p>
                    <div class="bbx__card-actions">
                      <button type="button" class="bbx__add" data-bbx-add {% unless v.available %}disabled{% endunless %}>
                        {%- if v.available -%}{{ s.label_add }}{%- else -%}{{ s.label_sold_out }}{%- endif -%}
                      </button>
                      <div class="bbx__stepper" data-bbx-stepper hidden>
                        <button type="button" class="bbx__step-btn" data-bbx-dec aria-label="Remove one {{ product.title | escape }}">&minus;</button>
                        <span class="bbx__qty" data-bbx-qty>0</span>
                        <button type="button" class="bbx__step-btn" data-bbx-inc aria-label="Add one {{ product.title | escape }}">+</button>
                      </div>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            {%- elsif request.design_mode -%}
              <p class="bbx__editor-hint">Pick a collection or products for this category.</p>
            {%- endif -%}
          </section>
        {%- else -%}
          {%- if request.design_mode -%}
            <p class="bbx__editor-hint">Add a "Product category" block and pick a collection to show products.</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Mobile dock: progress + add button pinned to the bottom while browsing products {%- endcomment -%}
  <div class="bbx__dock" data-bbx-dock>
    <button type="button" class="bbx__dock-info" data-bbx-view-box>
      <span class="bbx__dock-count">
        <span data-bbx-dock-count>0/{{ default_size }}</span>
        <span class="bbx__dock-view">
          {{- s.label_view_box -}}
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1.5 6.5 5 3l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </span>
      <span class="bbx__dock-status" data-bbx-dock-status></span>
    </button>
    <button type="button" class="bbx__cta" data-bbx-cta aria-disabled="true">
      {{- s.label_cta_more | replace: '[count]', default_size -}}
    </button>
  </div>
</bundle-builder>

{% stylesheet %}
  .bbx {
    --bbx-track: color-mix(in srgb, var(--bbx-ink) 26%, var(--bbx-panel-bg));
    --bbx-line: color-mix(in srgb, var(--bbx-ink) 22%, var(--bbx-panel-bg));
    --bbx-soft: color-mix(in srgb, #fff 50%, var(--bbx-panel-bg));
    --bbx-radius: 18px;
    display: block;
    background: var(--bbx-bg);
    color: var(--bbx-ink);
    font-family: var(--bbx-font, inherit);
    padding: var(--bbx-pt) 0 var(--bbx-pb);
    line-height: 1.4;
  }
  .bbx *,
  .bbx *::before,
  .bbx *::after {
    box-sizing: border-box;
  }
  .bbx [hidden] {
    display: none !important;
  }
  /* Resets against theme-wide tag styles. :where() keeps them at class-level specificity, and they come
     before the component rules, so components win while bare theme rules (button, h2, li) lose. */
  .bbx :where(button) {
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: none;
    text-shadow: none;
    -webkit-tap-highlight-color: transparent;
  }
  .bbx :where(h2, h3, p) {
    color: inherit;
    font-family: inherit;
    letter-spacing: normal;
    text-transform: none;
  }
  .bbx :where(ul, li) {
    margin: 0;
    padding: 0;
    float: none;
    list-style: none;
  }
  .bbx :where(li)::before {
    content: none;
  }
  .bbx :focus-visible {
    outline: 2px solid var(--bbx-ink);
    outline-offset: 2px;
  }
  .bbx__inner {
    max-width: var(--bbx-max);
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Header + category nav */
  .bbx__header {
    text-align: center;
    margin-bottom: 1.5em;
  }
  .bbx__heading {
    margin: 0;
    font-size: clamp(2em, 5vw, 3.25em);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .bbx__subheading {
    margin: 0.6em auto 0;
    max-width: 38em;
    font-size: 1.05em;
  }
  .bbx__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0 0 2.25em;
  }
  /* Sticky category bar: pins under the theme's sticky header (JS measures it into --bbx-offset).
     The background bleeds full width with a spread shadow, clipped to the bar's own height. */
  .bbx--sticky-nav .bbx__nav {
    position: sticky;
    top: var(--bbx-offset, 0px);
    z-index: 2;
    margin-bottom: 1.5em;
    padding-block: 12px;
    background: var(--bbx-bg);
    box-shadow: 0 0 0 100vmax var(--bbx-bg);
    clip-path: inset(0 -100vmax);
  }
  .bbx--sticky-nav .bbx__nav.is-stuck {
    box-shadow: 0 0 0 100vmax var(--bbx-bg), 0 2px 0 100vmax var(--bbx-line);
    clip-path: inset(0 -100vmax -2px);
  }
  @media screen and (max-width: 749px) {
    /* One swipeable row on phones instead of wrapping */
    .bbx__nav {
      flex-wrap: nowrap;
      justify-content: flex-start;
      margin-inline: -16px;
      padding: 2px 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .bbx__nav::-webkit-scrollbar {
      display: none;
    }
  }
  .bbx__pill {
    flex: 0 0 auto;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.35em 1em;
    border: var(--bbx-border, 2px) solid var(--bbx-ink);
    border-radius: var(--bbx-btn-radius, 999px);
    color: inherit;
    font-size: 0.9em;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }
  .bbx__pill:hover,
  .bbx__pill.is-active {
    background: var(--bbx-ink);
    color: var(--bbx-btn-fg);
  }
  .bbx--upper :is(.bbx__heading, .bbx__pill, .bbx__preset, .bbx__cat-title, .bbx__size, .bbx__badge, .bbx__card-title, .bbx__add, .bbx__cta) {
    text-transform: uppercase;
  }

  /* Layout: panel above the catalog on mobile, sticky on the right on desktop */
  .bbx__layout {
    display: grid;
    gap: 40px;
  }
  @media screen and (min-width: 990px) {
    .bbx__inner {
      padding: 0 32px;
    }
    .bbx__layout {
      grid-template-columns: minmax(0, 1fr) clamp(380px, 38%, 580px);
      gap: 48px;
      align-items: start;
    }
    .bbx__catalog {
      grid-column: 1;
      grid-row: 1;
    }
    .bbx__panel {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--bbx-offset, 0px) + var(--bbx-nav-h, 0px) + var(--bbx-sticky));
      max-height: calc(100vh - var(--bbx-offset, 0px) - var(--bbx-nav-h, 0px) - var(--bbx-sticky) - 16px);
      max-height: calc(100dvh - var(--bbx-offset, 0px) - var(--bbx-nav-h, 0px) - var(--bbx-sticky) - 16px);
      overflow-y: auto;
      scrollbar-width: thin;
    }
    /* Short screens: the panel scrolls inside, so keep the add button pinned to its bottom edge */
    .bbx__panel .bbx__cta {
      position: sticky;
      bottom: 0;
      z-index: 1;
      box-shadow: 0 0 0 10px var(--bbx-panel-bg);
    }
  }

  /* Prebuilt bundles strip */
  .bbx__presets {
    margin-bottom: 2.5em;
    padding: 22px 18px 24px;
    border-radius: var(--bbx-radius);
    background: color-mix(in srgb, var(--bbx-ink) 7%, var(--bbx-bg));
    text-align: center;
  }
  .bbx__presets-title {
    margin: 0 0 0.8em;
    font-size: 1.25em;
    font-weight: 800;
    line-height: 1.2;
  }
  .bbx__presets-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 14px;
  }
  .bbx__preset {
    min-width: 10em;
    min-height: 44px;
    padding: 0.4em 1.4em;
    border: var(--bbx-border, 2px) solid var(--bbx-ink);
    border-radius: var(--bbx-btn-radius, 999px);
    background: var(--bbx-bg);
    color: inherit;
    font-size: 0.9em;
    font-weight: 800;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .bbx__preset:hover,
  .bbx__preset.is-active {
    background: var(--bbx-ink);
    color: var(--bbx-btn-fg);
  }
  .bbx__preset[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Catalog */
  .bbx__cat {
    scroll-margin-top: calc(max(var(--bbx-offset, 0px), var(--bbx-header-h, 0px)) + var(--bbx-nav-h, 0px) + 16px);
  }
  .bbx__cat + .bbx__cat {
    margin-top: 3em;
  }
  .bbx__cat-title {
    margin: 0 0 0.6em;
    font-size: clamp(1.75em, 3.5vw, 2.5em);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .bbx__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--bbx-cols-m), minmax(0, 1fr));
    gap: 12px;
  }
  @media screen and (min-width: 750px) {
    .bbx__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }
  @media screen and (min-width: 990px) {
    .bbx__grid {
      grid-template-columns: repeat(var(--bbx-cols-d), minmax(0, 1fr));
    }
  }
  .bbx__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5em;
    padding: 12px 10px 14px;
    border: var(--bbx-border, 2px) solid var(--bbx-ink);
    border-radius: var(--bbx-radius);
    background: var(--bbx-card);
    text-align: center;
    transition: background-color 0.2s;
  }
  @media screen and (min-width: 750px) {
    .bbx__card {
      padding: 18px 16px 18px;
    }
  }
  .bbx__card.is-selected {
    background: var(--bbx-selected);
  }
  .bbx__card-media {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: max(0px, calc(var(--bbx-radius) - 6px));
  }
  .bbx__card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s;
  }
  .bbx--fit-cover .bbx__card-img {
    object-fit: cover;
  }
  .bbx__card:hover .bbx__card-img {
    transform: scale(1.04);
  }
  .bbx__placeholder {
    background: var(--bbx-soft);
    fill: var(--bbx-line);
  }
  .bbx__card-title {
    flex-grow: 1;
    margin: 0.35em 0 0;
    font-size: 0.95em;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.02em;
  }
  .bbx__card-variant {
    margin: -0.2em 0 0;
    font-size: 0.8em;
    opacity: 0.75;
  }
  .bbx__card-price {
    margin: 0;
    font-weight: 800;
  }
  .bbx__card-price s {
    font-weight: 500;
    opacity: 0.6;
  }
  .bbx__card-actions {
    width: 100%;
    margin-top: 0.25em;
  }
  .bbx__add,
  .bbx__stepper {
    width: 100%;
    min-height: 44px;
    border: 0;
    border-radius: var(--bbx-btn-radius, 999px);
    background: var(--bbx-ink);
    color: var(--bbx-btn-fg);
    font-size: 0.95em;
    font-weight: 800;
    letter-spacing: 0.03em;
