{% schema %}
{
  "name": "Bundle builder",
  "tag": "section",
  "class": "bbx-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your box"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick a box size, fill it with favorites, and save more the bigger you go."
    },
    {
      "type": "text",
      "id": "presets_heading",
